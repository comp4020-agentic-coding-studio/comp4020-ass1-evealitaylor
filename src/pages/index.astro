---
import Layout from "../layouts/Layout.astro";

const KEYS = [
  { id: "bronze", label: "Bronze key", bitting: [0.9, 1.3, 0.6, 1.1, 0.75] },
  { id: "steel", label: "Steel key", bitting: [0.3, 1.4, 0.5, 1.3, 0.4] },
  { id: "brass", label: "Brass key", bitting: [1.5, 0.5, 1.5, 0.5, 1.5] },
  { id: "silver", label: "Silver key", bitting: [1, 1, 0.85, 1, 1] },
];

const PIN_COUNT = 5;

const ALL_BITTING = KEYS.flatMap((key) => key.bitting);
const BITTING_MIN = Math.min(...ALL_BITTING);
const BITTING_MAX = Math.max(...ALL_BITTING);

// The lock's own pins are cut to one specific key's bitting, same as a real
// pin-tumbler lock — that's what makes only one key "work". Bronze is the
// one built to fit; the others are close-but-wrong on purpose so the pins
// visibly land off the shear line.
const LOCK_KEY_ID = "bronze";
const LOCK_BITTING = KEYS.find((key) => key.id === LOCK_KEY_ID)!.bitting;

// Fraction of chamber height (from the top) where the shear line sits —
// must match `.shear-line`'s `top: 45%` in global.css. Pin lift math in
// main.ts uses the same LIFT_SCALE so a key whose bitting equals
// LOCK_BITTING lands its pins on the shear line at full insertion, and any
// other key misses by an amount proportional to how far its cut differs.
const SHEAR_FRAC = 0.45;
const LIFT_SCALE = 0.25;

// Chamber's key/driver pin lengths are fixed by the lock's own design, not
// by whichever key is currently selected — this is what makes the pins
// start uneven at rest instead of every chamber sharing one split.
function pinRestSplit(designValue: number): { topPct: number; bottomPct: number } {
  const topPct = (SHEAR_FRAC + designValue * LIFT_SCALE) * 100;
  return { topPct, bottomPct: 100 - topPct };
}

// Cuts into the shaft's right edge in PIN_COUNT bands, one per pin. Deeper
// cuts (lower bitting value) leave less shaft material — this same right
// edge becomes the top edge once the key rotates horizontal to slide into
// the keyway, so a shallow remainder here is what lifts its matching pin
// less at that point along the blade. Bands are joined by a sloped chamfer
// rather than a sharp right-angle step, so the profile reads as milled
// rather than laser-cut, and the tip narrows to a point instead of ending
// in a flat edge.
function shaftClipPath(bitting: number[]): string {
  const minRemain = 15;
  const maxRemain = 95;
  const range = BITTING_MAX - BITTING_MIN || 1;
  const remainOf = (value: number) =>
    minRemain + ((value - BITTING_MIN) / range) * (maxRemain - minRemain);

  const n = bitting.length;
  const bandHeight = 100 / n;
  const chamferFrac = 0.4;
  const tipTaperFrac = 0.22;
  const tipApexX = 50;

  const rightPoints: string[] = [];
  let prevRemain = 100;
  let tipStart = 100;
  bitting.forEach((value, i) => {
    const remain = remainOf(value);
    const top = i * bandHeight;
    const bottom = (i + 1) * bandHeight;
    const chamferEnd = top + bandHeight * chamferFrac;

    rightPoints.push(`${prevRemain}% ${top}%`, `${remain}% ${chamferEnd}%`);

    if (i === n - 1) {
      // Both edges taper inward over the last stretch of blade to meet at a
      // single point, instead of the cut edge alone stepping in — that's
      // what makes the tip read as machined to a point rather than just cut
      // short.
      tipStart = Math.max(chamferEnd, bottom - bandHeight * tipTaperFrac);
      rightPoints.push(`${remain}% ${tipStart}%`);
    } else {
      rightPoints.push(`${remain}% ${bottom}%`);
    }

    prevRemain = remain;
  });

  const points = [
    "0% 0%",
    "100% 0%",
    ...rightPoints,
    `${tipApexX}% 100%`,
    `0% ${tipStart}%`,
  ];
  return `polygon(${points.join(", ")})`;
}
---

<Layout title="How locks work">
  <nav aria-label="Primary" class="visually-hidden">
    <a href="./">Home</a>
  </nav>
  <main>
    <h1>How locks work</h1>
    <p class="tagline">
      Pick a key. Try it. Watch what has to line up before it turns.
    </p>

    <div class="stage">
      <section class="keychain" aria-label="Choose a key">
        <div class="keyring" aria-hidden="true"></div>
        <ul class="key-list" data-testid="key-list">
          {
            KEYS.map((key, i) => (
              <li class={`key-item key-fan-${i + 1}`}>
                <button
                  type="button"
                  class={`key key-${key.id}`}
                  data-key={key.id}
                  data-testid={`key-${key.id}`}
                  data-bitting={key.bitting.join(",")}
                >
                  <span class="key-head" aria-hidden="true">
                    <span class="key-hole" aria-hidden="true"></span>
                  </span>
                  <span
                    class="key-shaft"
                    aria-hidden="true"
                    style={`clip-path: ${shaftClipPath(key.bitting)}`}
                  ></span>
                  <span class="visually-hidden">{key.label}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </section>

      <section
        class="lock-stage"
        aria-label="Lock cross-section"
        data-testid="lock-stage"
      >
        <div class="lock">
          <div class="lock-body">
            <div
              class="pin-stack"
              aria-hidden="true"
              data-lock-bitting={LOCK_BITTING.join(",")}
              data-lift-scale={LIFT_SCALE}
            >
              {
                Array.from({ length: PIN_COUNT }).map((_, i) => {
                  const { topPct, bottomPct } = pinRestSplit(LOCK_BITTING[i]);
                  return (
                    <div class="pin-chamber" data-testid={`pin-chamber-${i}`}>
                      <div class="pin-assembly">
                        <span
                          class="pin pin-top"
                          style={`flex: 0 0 ${topPct}%`}
                        ></span>
                        <span
                          class="pin pin-bottom"
                          style={`flex: 0 0 ${bottomPct}%`}
                        ></span>
                      </div>
                    </div>
                  );
                })
              }
              <div class="shear-line" data-testid="shear-line"></div>
            </div>
            <div class="keyway" data-testid="keyway" aria-hidden="true"></div>
          </div>
          <div class="lock-cam" aria-hidden="true"></div>
        </div>
      </section>
    </div>

    <section class="controls" aria-label="Try the selected key">
      <p class="controls-hint" data-testid="controls-hint" aria-live="polite">
        Select a key above to try it.
      </p>
      <div class="controls-insert">
        <label for="insert-slider">Insert key</label>
        <input
          id="insert-slider"
          type="range"
          min="0"
          max="100"
          value="0"
          disabled
        />
      </div>
      <button class="turn-key" type="button" disabled data-testid="turn-key">
        Turn key
      </button>
    </section>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
